{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pulso.example/events/order.created.v1.schema.json",
  "title": "order.created v1",
  "description": "An order was accepted. pulso-saga reacts by requesting payment authorization.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.v1.schema.json" }],
  "properties": {
    "type": { "const": "order.created" },
    "data": {
      "type": "object",
      "required": ["orderId", "merchantId", "amountCents", "currency", "pickup", "dropoff", "items"],
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "merchantId": { "type": "string", "format": "uuid" },
        "amountCents": { "type": "integer", "minimum": 1 },
        "currency": { "const": "MXN" },
        "pickup": { "$ref": "common.v1.schema.json#/$defs/location" },
        "dropoff": { "$ref": "common.v1.schema.json#/$defs/location" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.v1.schema.json#/$defs/item" }
        }
      },
      "additionalProperties": false
    }
  }
}
