PORT=3000
# memory | prisma
PERSISTENCE=prisma
DATABASE_URL=postgresql://pulso:pulso@localhost:5432/pulso_orders?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=pulso-orders-api
JWT_TTL_SECONDS=3600
# Outbox relay: polls outbox_events and delivers committed events
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
# Unset = log events to stdout; set = POST each event (e.g. pulso-saga ingress)
EVENTS_WEBHOOK_URL=
# Idempotency keys: replay window and cleanup of expired keys
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_CLEANUP_ENABLED=true
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
# Per-merchant token bucket (burst / sustained per second) and per-IP bucket for public routes
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=10
RATE_LIMIT_ANON_CAPACITY=10
RATE_LIMIT_ANON_REFILL_PER_SECOND=1
# Set to true behind a load balancer so the client IP is used
TRUST_PROXY=false
